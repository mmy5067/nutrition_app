# Leave empty to use the built-in local SQLite database.
DATABASE_URL=sqlite:./db/local.sqlite

SECRET_KEY=change_me_to_a_random_long_value
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

# Local bootstrap admin for development/testing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# Project port is fixed to 5000 in package.json to match the current Nginx proxy_pass.
