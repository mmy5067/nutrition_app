# Leave empty to use the built-in local SQLite database.
DATABASE_URL=sqlite:./db/local.sqlite

# Required. npm run setup generates unique values in .env.local.
SECRET_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Bootstrap admin is created and email-verified automatically on first database use.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Required for new users to verify their email; not needed for the bootstrap admin.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=http://localhost:5000

# SMTP currently uses implicit TLS (usually port 465), not port 587 STARTTLS.
